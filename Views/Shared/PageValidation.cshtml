@model TPLOCAL1.Models.Informations
<!DOCTYPE html>
<html>
    <head>
        <title>Page de validation</title>
        <link rel="stylesheet" href="~/resources/Index.css" />
    </head>
    <body>
        <header>
            <img src="~/resources/GroupeHN.png" class="image" alt="GroupeHN" />
            <h1>Page de validation</h1>
        </header>
        <nav>
            <ul>
                <li><a href="/Home/Index">Accueil</a></li>
                <li><a href="/Home/Index/AvisList">Liste Avis</a></li>
            </ul>
        </nav>
        <p class="validation">Votre formulaire a bien été pris en compte.</p>

        <table>
            <tr>
                <th colspan="2">Informations personnelles</th>
            </tr>
            <tr><td>Nom</td><td>@Model.Nom</td></tr>
            <tr><td>Prénom</td><td>@Model.Prénom</td></tr>
            <tr><td>Genre</td><td>@Model.Genre</td></tr>
            <tr><td>Adresse</td><td>@Model.Adresse</td></tr>
            <tr><td>Code postal</td><td>@Model.CodePostal</td></tr>
            <tr><td>Ville</td><td>@Model.Ville</td></tr>
            <tr><td>Adresse courriel</td><td>@Model.Courriel</td></tr>
        </table>

        <table>
            <tr>
                <th colspan="2">Informations formation suivie</th>
            </tr>
            <tr>
                <td>Date de début de la formation</td>
                <td>@(Model.DateDebut?.ToString("dd/MM/yyyy"))</td>
            </tr>
            <tr><td>Type de formation</td><td>@Model.TypeFormation</td></tr>
        </table>

        <table>
            <tr>
                <th colspan="2">Avis sur la formation</th>
            </tr>
            <tr><td>Formation Cobol</td><td>@Model.Cobol</td></tr>
            <tr><td>Formation C#</td><td>@Model.CSharp</td></tr>
        </table>
    


    </body>
</html>
